      "writtenOn": "2022-11-16T01:50:02Z",
      "side": 1,
      "message": "Bug does not exist in 13-5.15, so patch not needed here. Fix needed in 13-5.15-lts and 13-5.10-lts. Recommend cherry-picking the fix from android12-5.10: aosp/2242704 (commit b046e2dca512d)",
      "revId": "f150b10367fbd9feddd1ac93d5953fde0ec96b9b",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
