    {
      "key": {
        "uuid": "c9f10887_c76eea93",
        "filename": "drivers/cpufreq/cpufreq_times.c",
        "patchSetId": 6
      },
      "lineNbr": 100,
      "author": {
        "id": 1003665
      },
      "writtenOn": "2018-02-17T03:28:32Z",
      "side": 1,
      "message": "Why not just move this outside the loop and call it a day? I don\u0027t see the point of lock and unlocking it so often. How often is this file read? The only concern is if this file is read while acct_update() is called during a tick. Then the seq_printf() time could be saved. But not sure if locking and unlocking so often is worth that optimization (considering that lock/unlock itself has memory barriers in there which are probably more expensive than seq_printf())",
      "range": {
        "startLine": 100,
        "startChar": 22,
        "endLine": 100,
        "endChar": 45
      },
      "revId": "25866078274b014a87e4b03f112d6ee0329a4414",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
