      "side": 1,
      "message": "How do you determine which ops are critical?",
      "revId": "1062c02cb2b5b4ebbfaddff39afcef6879530181",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": false,
      "key": {
        "uuid": "d162d529_60a9845d",
        "filename": "/COMMIT_MSG",
        "patchSetId": 1
