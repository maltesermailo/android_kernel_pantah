      "writtenOn": "2026-04-23T16:58:24Z",
      "side": 1,
      "message": "why is this needed? This patch is adding GKI modules, so these modules can select what they need. These hidden configs are normally used to select configs on behalf of vendor modules.",
      "revId": "490fd0b7a7a69e3647b0d8cb16e1fa97eec4ab79",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
