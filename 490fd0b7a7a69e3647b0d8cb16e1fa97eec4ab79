        "patchSetId": 3
      },
      "lineNbr": 54,
      "author": {
        "id": 3386406
      },
      "writtenOn": "2026-04-24T19:31:16Z",
      "side": 1,
      "message": "Many SND_HDA driver Kconfig entries are gated by the SND_HDA config https://cs.android.com/android/kernel/superproject/+/common-android16-6.12:common/sound/pci/hda/Kconfig;l\u003d45, which is a hidden config.\nTo unblock those Kconfig entries and subsequently their drivers from being built as gki module, added it here as a hidden config for selection.",
      "parentUuid": "79ef99e2_fae81ccc",
      "revId": "490fd0b7a7a69e3647b0d8cb16e1fa97eec4ab79",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
