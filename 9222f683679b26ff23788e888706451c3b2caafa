      "key": {
        "uuid": "de8df895_427afdac",
        "filename": "drivers/staging/android/virt_wifi.c",
        "patchSetId": 2
      },
      "lineNbr": 208,
      "author": {
        "id": 1291337
      },
      "writtenOn": "2018-11-14T21:19:13Z",
      "side": 1,
      "message": "Not deliberately, what would a better ordering be?",
      "parentUuid": "33c9d10b_4deec45c",
      "revId": "9222f683679b26ff23788e888706451c3b2caafa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
