      "writtenOn": "2018-11-15T07:49:51Z",
      "side": 1,
      "message": "In that case the current structure seems fine, just swap `is_connected` and `being_deleted`.",
      "parentUuid": "89577424_422bde1f",
      "revId": "9222f683679b26ff23788e888706451c3b2caafa",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
