    {
      "key": {
        "uuid": "532180bd_67873e9a",
        "filename": "README.md",
        "patchSetId": 4
      },
      "lineNbr": 52,
      "author": {
        "id": 1069543
      },
      "writtenOn": "2019-10-25T02:40:46Z",
      "side": 1,
      "message": "I don\u0027t think we need to do anything extra to capture changes -- if we care, we can compare the backported patch to the original one.\n\nI would BACKPORT is needed if \"git cherry-pick\" or \"git am\" doesn\u0027t apply the patch cleanly. If any conflict resolution changes are needed, then it\u0027s a BACKPORT. So that would include conflicts that only modify comments and whitespace.",
      "parentUuid": "defa96aa_d569e4b3",
      "range": {
        "startLine": 52,
        "startChar": 83,
        "endLine": 52,
        "endChar": 91
      },
      "revId": "116fb2fbfe6201f68b974a6474393c5fe8df1a7f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
      "unresolved": true
    },
