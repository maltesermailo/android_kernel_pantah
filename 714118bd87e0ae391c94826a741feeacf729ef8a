                "startLine": 309,
                "startChar": 0,
                "endLine": 312,
                "endChar": 0
              },
              "replacement": "\t// Donate the rest of the memory if size is larger than one page.\n\tif (size \u003e PAGE_SIZE) {\n\t\tret \u003d donate_host_memory(va + PAGE_SIZE, size - PAGE_SIZE);\n\t\tif (ret)\n\t\t\tgoto undonate_first_page;\n\t}\n"
            },
            {
              "path": "arch/x86/kvm/pkvm/pkvm.c",
              "range": {
                "startLine": 319,
                "startChar": 0,
                "endLine": 319,
                "endChar": 0
