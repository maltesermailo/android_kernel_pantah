    {
      "unresolved": false,
      "key": {
        "uuid": "f3703bd8_3666a05f",
        "filename": "net/core/dev.c",
        "patchSetId": 4
      },
      "lineNbr": 1307,
      "author": {
        "id": 1876090
      },
      "writtenOn": "2022-06-09T13:05:26Z",
      "side": 1,
      "message": "This is also important for us, following is the use case.\n1. In case of 2 Android\u0027s running as Guests in Multi guest environment case, we are using virtio_net driver, which always names the inferface name as eth0.\n\nSince Android Guest works on Static IP configurations, IP is assigned by Network service in android based on interface name. \n\nIn Dual LA, both guests get eth0 as interface name and both guests would get same IP, which is conflicting. So we are renaming ethernet interface name based on Guest ID. \nfor renaming eth interface name, we need this API.\n\nWe have raised Google bug also for this same problem @ https://partnerissuetracker.corp.google.com/issues/221002829\n\nplease share your thoughts",
      "parentUuid": "b66834bc_ba4ea527",
      "range": {
        "startLine": 1307,
        "startChar": 0,
        "endLine": 1307,
        "endChar": 35
      },
      "revId": "988069ca60625b6cf26035c521b6505ad1899cac",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
      "unresolved": true,
      "key": {
        "uuid": "4a24e819_d5caedf4",
        "filename": "net/core/dev.c",
        "patchSetId": 4
      },
      "lineNbr": 1307,
      "author": {
        "id": 1125653
      },
      "writtenOn": "2022-06-09T13:08:10Z",
      "side": 1,
      "message": "No, this is not allowed to be used by anyone, EXCEPT by the networking core, sorry.  The logistics involved are just too complex to export to a module.\n\nIf you think otherwise, please submit the code that uses this upstream for review and we will be glad to consider it.\n\nAlso, networking names should always be managed from userspace, not from within the kernel and NEVER from within a driver itself.  Just do this from userspace today.",
      "parentUuid": "f3703bd8_3666a05f",
      "range": {
        "startLine": 1307,
        "startChar": 0,
        "endLine": 1307,
        "endChar": 35
      },
      "revId": "988069ca60625b6cf26035c521b6505ad1899cac",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    }
