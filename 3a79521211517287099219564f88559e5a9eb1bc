      "writtenOn": "2022-12-12T20:16:47Z",
      "side": 1,
      "message": "Ok, I think I understand. Does this also mean that the trusty_get_requested_nice() should also be down a few levels in the call stack within trusty_std_call_helper() (instead of in nop_work_func())?",
      "parentUuid": "649d0afd_c8c51cb2",
      "revId": "3a79521211517287099219564f88559e5a9eb1bc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
