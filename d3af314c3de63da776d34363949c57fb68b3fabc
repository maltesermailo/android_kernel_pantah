      "author": {
        "id": 3702829
      },
      "writtenOn": "2025-09-24T16:13:57Z",
      "side": 1,
      "message": "Yeah true, READ_ONCE should be sufficient!",
      "parentUuid": "8726796d_69d95743",
      "revId": "d3af314c3de63da776d34363949c57fb68b3fabc",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
