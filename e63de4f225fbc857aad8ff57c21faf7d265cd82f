      "side": 1,
      "message": "Hmm... we initialize `domain` after we already added it to `iommu_domains` AND unlocked iommu_domain_lock? We have a race, right?",
      "revId": "e63de4f225fbc857aad8ff57c21faf7d265cd82f",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889"
    },
    {
