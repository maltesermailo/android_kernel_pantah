      "side": 0,
      "message": "Given that this is a complex type, I would prefer that we resolve this \u0027conflict\u0027 by exposing it properly to the ABI tools instead of \u0027hiding\u0027 it behind a u32.",
      "range": {
        "startLine": 62,
        "startChar": 1,
        "endLine": 62,
        "endChar": 23
      },
      "revId": "fc99bcd94b4d2b414a05926a8f1c3536cd0516bd",
