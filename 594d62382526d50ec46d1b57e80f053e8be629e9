      "writtenOn": "2022-10-13T13:42:08Z",
      "side": 1,
      "message": "this is a huge sign that the code using these is wrong and incorrect.\n\nDo you have a pointer to where this code is so that I can verify that it is working properly?  Walking all devices and class devices should not be a normal task for a driver and might be the sign of a driver trying to take over a device it should not be controlling.",
      "range": {
        "startLine": 117,
        "startChar": 2,
        "endLine": 119,
        "endChar": 21
      },
      "revId": "594d62382526d50ec46d1b57e80f053e8be629e9",
