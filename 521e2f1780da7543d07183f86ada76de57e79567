        "id": 1729538
      },
      "writtenOn": "2022-02-23T10:24:09Z",
      "side": 1,
      "message": "It is pretty odd to mark the vcpu as loaded outside of vcpu_load. This function looks like a generic helper, but it really isn\u0027t.",
      "range": {
        "startLine": 293,
        "startChar": 0,
        "endLine": 295,
        "endChar": 0
      },
      "revId": "521e2f1780da7543d07183f86ada76de57e79567",
