      "writtenOn": "2025-06-09T15:46:44Z",
      "side": 1,
      "message": "Good point, adding a pointer to keep the last free handle and optimized the store.",
      "parentUuid": "6ce3804a_43ad9aff",
      "revId": "39d5d9e55c8a360656ab9f30465fa9563b4a40d4",
