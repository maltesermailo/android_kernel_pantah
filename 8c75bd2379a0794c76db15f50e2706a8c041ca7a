      "author": {
        "id": 1928805
      },
      "writtenOn": "2026-02-26T02:43:46Z",
      "side": 1,
      "message": "It was originally a #define, I changed it per Todd\u0027s request: https://android-review.googlesource.com/c/kernel/common/+/3292854/comment/9d50cfb5_2be30b77/",
      "parentUuid": "71da5d40_487fb853",
