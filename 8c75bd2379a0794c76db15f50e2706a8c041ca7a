      "lineNbr": 298,
      "author": {
        "id": 1869395
      },
      "writtenOn": "2026-02-26T18:17:45Z",
      "side": 1,
      "message": "@tkjos@google.com this is a hardcoded value for GKI so there is no ability for different vendors to configure their own. Making it a config creates more trouble IMO. I think this needs to be a define.",
      "parentUuid": "56eb8514_083da81f",
