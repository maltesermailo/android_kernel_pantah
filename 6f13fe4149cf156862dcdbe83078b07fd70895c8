      },
      "writtenOn": "2018-02-13T21:50:38Z",
      "side": 1,
      "message": "why is this atomic? I don\u0027t see any atomic ops on it.",
      "revId": "6f13fe4149cf156862dcdbe83078b07fd70895c8",
      "serverId": "85c56323-6fa9-3386-8a01-6480fb634889",
