      "message": "It is null once init skipped, so destroy is fine",
      "tag": "mailMessageId\u003d\u003cCAGXk5yqOmCkiEGPn4twx20AHOV1k0Jz316BPgVHBXw\u003dWB4FtsA@mail.gmail.com\u003e",
      "revId": "243f6f183fa689d9212624592b8f4d203d4aaca3",
