    },
    {
      "unresolved": false,
      "key": {
        "uuid": "c5a296f0_a6791732",
        "filename": "drivers/thermal/thermal_sysfs.c",
        "patchSetId": 1
      },
      "lineNbr": 950,
      "author": {
        "id": 1903606
      },
      "writtenOn": "2022-03-01T12:15:32Z",
      "side": 1,
      "message": "My understanding is that you are suggesting to have some devicetree property for each cooling device provider as similar to #cooling-cell property and based on that decide whether to enable it or not, right ?. It could handle for most of the cooling devices but one caveat is that some cooling devices in upstream are still registering cooling devices without of interfaces. For those cdevs, framework cannot check DT property. Anyway I will bring this to upstream and check it.",
      "parentUuid": "0b6173b6_3eb388cc",
      "range": {
        "startLine": 941,
        "startChar": 0,
        "endLine": 950,
        "endChar": 0
      },
      "revId": "243f6f183fa689d9212624592b8f4d203d4aaca3",
