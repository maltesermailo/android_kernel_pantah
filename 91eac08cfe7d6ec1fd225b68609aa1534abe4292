    {
      "key": {
        "uuid": "22154b53_66563ba9",
        "filename": "fs/incfs/stats.c",
        "patchSetId": 3
      },
      "lineNbr": 23,
      "author": {
        "id": 1724998
      },
      "writtenOn": "2020-07-21T16:53:26Z",
      "side": 1,
      "message": "This is just informational. Generally, people write plugins (such as collectd...) around these stats and these headers generally have [\u003cStats-Name\u003e-\u003cVersion\u003e] so that consumer of these stats can parse based on versioning. Well, I guess we don\u0027t any of those plans yet.",
      "parentUuid": "a1ff13c2_7acd8968",
      "range": {
        "startLine": 23,
        "startChar": 0,
        "endLine": 23,
        "endChar": 46
      },
      "revId": "91eac08cfe7d6ec1fd225b68609aa1534abe4292",
