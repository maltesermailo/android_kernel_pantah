      "writtenOn": "2024-09-10T19:17:01Z",
      "side": 1,
      "message": "I\u0027m confused about how that will help. Enabling this on AOSP won\u0027t get it enabled for our current config. We\u0027re currently not using the AOSP kernel config system and not using GKI. We need to enable it in _both_ places. Short term the only config that will mater is here. Long term the only config that will matter is AOSP.",
      "parentUuid": "7f8460df_2949b830",
      "range": {
        "startLine": 7,
        "startChar": 0,
        "endLine": 7,
        "endChar": 57
      },
      "revId": "cf82322e1f25b53701e3ce9320bd7bb3831020be",
