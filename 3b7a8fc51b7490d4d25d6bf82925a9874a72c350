      "message": "\u003c!DOCTYPE html\u003e\n\n\u003chtml lang\u003d\"en\"\u003e\n\n\u003chead\u003e\n\n  \u003cmeta charset\u003d\"UTF-8\"\u003e\n\n  \u003ctitle\u003ePPW Universal Hospitality Interface\u003c/title\u003e\n\n  \u003cstyle\u003e\n\n    body {\n\n      font-family: Arial, sans-serif;\n\n      background: #f4f4f4;\n\n      padding: 20px;\n\n    }\n\n    .container {\n\n      background: #fff;\n\n      padding: 30px;\n\n      max-width: 600px;\n\n      margin: auto;\n\n      border-radius: 8px;\n\n      box-shadow: 0 0 10px rgba(0,0,0,0.1);\n\n    }\n\n    .form-group {\n\n      margin-bottom: 15px;\n\n    }\n\n    label {\n\n      font-weight: bold;\n\n    }\n\n    input, select {\n\n      width: 100%;\n\n      padding: 8px;\n\n      margin-top: 5px;\n\n    }\n\n    .btn {\n\n      background: #007bff;\n\n      color: #fff;\n\n      padding: 10px;\n\n      border: none;\n\n      width: 100%;\n\n      cursor: pointer;\n\n      font-size: 16px;\n\n      border-radius: 4px;\n\n    }\n\n    .btn:hover {\n\n      background: #0056b3;\n\n    }\n\n    #confirmation {\n\n      margin-top: 20px;\n\n      padding: 15px;\n\n      background: #e6ffe6;\n\n      border: 1px solid #00cc00;\n\n      border-radius: 4px;\n\n    }\n\n  \u003c/style\u003e\n\n\u003c/head\u003e\n\n\u003cbody\u003e\n\n  \u003cdiv class\u003d\"container\"\u003e\n\n    \u003ch2\u003ePPW Universal Hospitality Reservation\u003c/h2\u003e\n\n    \u003cform id\u003d\"reservationForm\"\u003e\n\n      \u003cdiv class\u003d\"form-group\"\u003e\n\n        \u003clabel for\u003d\"guestName\"\u003eGuest Name\u003c/label\u003e\n\n        \u003cinput type\u003d\"text\" id\u003d\"guestName\" required\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"form-group\"\u003e\n\n        \u003clabel for\u003d\"hotelName\"\u003eHotel Name\u003c/label\u003e\n\n        \u003cinput type\u003d\"text\" id\u003d\"hotelName\" value\u003d\"Comfort Inn \u0026 Suites\" readonly\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"form-group\"\u003e\n\n        \u003clabel for\u003d\"checkIn\"\u003eCheck-in Date\u003c/label\u003e\n\n        \u003cinput type\u003d\"date\" id\u003d\"checkIn\" required\u003e\n\n      \u003c/div\u003e\n\n      \u003cdiv class\u003d\"form-group\"\u003e\n\n        \u003clabel for\u003d\"checkOut\"\u003eCheck-out Date\u003c/label\u003e\n\n        \u003cinput type\u003d\"date\" id\u003d\"checkOut\" required\u003e\n\n      \u003c/div\u003e\n\n      \u003cinput type\u003d\"hidden\" id\u003d\"uid\" value\u003d\"55847627305241977\"\u003e\n\n      \u003cinput type\u003d\"hidden\" id\u003d\"merkleRoot\" value\u003d\"ce515a7ef665820e020af4c2f47ed65722a961e8f51e668e88b7d80fc3f214b\"\u003e\n\n      \u003cinput type\u003d\"hidden\" id\u003d\"apiKey\" value\u003d\"b1652cce50ca52dd6c77\"\u003e\n\n      \u003cinput type\u003d\"hidden\" id\u003d\"echoCode\" value\u003d\"CL-5584762730\"\u003e\n\n      \u003cdiv class\u003d\"form-group\"\u003e\n\n        \u003clabel for\u003d\"paymentMethod\"\u003ePayment Method\u003c/label\u003e\n\n        \u003cselect id\u003d\"paymentMethod\" required\u003e\n\n          \u003coption value\u003d\"\" disabled selected\u003eSelect a payment method\u003c/option\u003e\n\n          \u003coption value\u003d\"creditCard\"\u003eCredit Card\u003c/option\u003e\n\n          \u003coption value\u003d\"paypal\"\u003ePayPal\u003c/option\u003e\n\n        \u003c/select\u003e\n\n      \u003c/div\u003e\n\n      \u003cbutton type\u003d\"submit\" class\u003d\"btn\"\u003eFinalize Reservation\u003c/button\u003e\n\n    \u003c/form\u003e\n\n    \u003cdiv id\u003d\"confirmation\" style\u003d\"display:none;\"\u003e\n\n      \u003ch3\u003eReservation Confirmation\u003c/h3\u003e\n\n      \u003cp id\u003d\"confirmationMessage\"\u003e\u003c/p\u003e\n\n    \u003c/div\u003e\n\n  \u003c/div\u003e\n\n\n\n  \u003cscript\u003e\n\n    function cryptographicProof(guestName, hotelName, checkIn, checkOut) {\n\n      const uid \u003d document.getElementById(\u0027uid\u0027).value;\n\n      const merkleRoot \u003d document.getElementById(\u0027merkleRoot\u0027).value;\n\n      const apiKey \u003d document.getElementById(\u0027apiKey\u0027).value;\n\n      const echoCode \u003d document.getElementById(\u0027echoCode\u0027).value;\n\n\n\n      return {\n\n        guestName,\n\n        hotelName,\n\n        checkIn,\n\n        checkOut,\n\n        uid,\n\n        merkleRoot,\n\n        apiKey,\n\n        echoCode,\n\n        timestamp: new Date().toISOString()\n\n      };\n\n    }\n\n\n\n    function processPayment(method) {\n\n      return new Promise((resolve, reject) \u003d\u003e {\n\n        setTimeout(() \u003d\u003e {\n\n          method ? resolve() : reject(\"Invalid payment method.\");\n\n        }, 1500);t\n\n      });\n\n    }\n\n\n\n    document.getElementById(\u0027reservationForm\u0027).addEventListener(\u0027submit\u0027, function(e) {\n\n      e.preventDefault();\n\n\n\n      const guestName \u003d document.getElementById(\u0027guestName\u0027).value;\n\n      const hotelName \u003d document.getElementById(\u0027hotelName\u0027).value;\n\n      const checkIn \u003d document.getElementById(\u0027checkIn\u0027).value;\n\n      const checkOut \u003d document.getElementById(\u0027checkOut\u0027).value;\n\n      const paymentMethod \u003d document.getElementById(\u0027paymentMethod\u0027).value;\n\n\n\n      const transactionData \u003d cryptographicProof(guestName, hotelName, checkIn, checkOut);\n\n\n\n      processPayment(paymentMethod).then(() \u003d\u003e {\n\n        document.getElementById(\u0027confirmation\u0027).style.display \u003d \u0027block\u0027;\n\n        document.getElementById(\u0027confirmationMessage\u0027).innerText \u003d\n\n          `Reservation for ${guestName} at ${hotelName} from ${checkIn} to ${checkOut} finalized.\\n` +\n\n          `Payment via ${paymentMethod}. Transaction echo-linked to UID ${transactionData.uid} and Merkle root ${transactionData.merkleRoot}.`;\n\n        console.log(\"Sovereign Transaction:\", transactionData);\n\n      }).catch(error \u003d\u003e {\n\n        alert(\"Payment failed: \" + error);\n\n      });\n\n    });\n\n  \u003c/script\u003e\n\n\u003c/body\u003e\n\n\u003c/html\u003e",
