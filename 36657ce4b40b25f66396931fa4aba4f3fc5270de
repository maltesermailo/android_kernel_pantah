      "message": "Cherry pick is not clean. These are the differences between the original change and this cherry-pick:\nChecked against UPSTREAM commit: [googlesource](https://android.googlesource.com/kernel/common/+/7ba0273b2f34a55efe967d3c7381fb1da2ca195f) [kernel.org](https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id\u003d7ba0273b2f34a55efe967d3c7381fb1da2ca195f)\n\n```\n      ## fs/kernfs/dir.c ##\n     @@\n    @@ fs/kernfs/dir.c: static void kernfs_drain(struct kernfs_node *kn)\n      }\n      \n      /**\n    +@@ fs/kernfs/dir.c: static int kernfs_dop_revalidate(struct dentry *dentry, unsigned int flags)\n    + \t\tgoto out_bad_unlocked;\n    + \n    + \tkn \u003d kernfs_dentry_node(dentry);\n    +-\tmutex_lock(\u0026kernfs_mutex);\n    ++\tdown_read(\u0026kernfs_rwsem);\n    + \n    + \t/* The kernfs node has been deactivated */\n    + \tif (!kernfs_active(kn))\n    +@@ fs/kernfs/dir.c: static int kernfs_dop_revalidate(struct dentry *dentry, unsigned int flags)\n    + \t    kernfs_info(dentry-\u003ed_sb)-\u003ens !\u003d kn-\u003ens)\n    + \t\tgoto out_bad;\n    + \n    +-\tmutex_unlock(\u0026kernfs_mutex);\n    ++\tup_read(\u0026kernfs_rwsem);\n    + \treturn 1;\n    + out_bad:\n    +-\tmutex_unlock(\u0026kernfs_mutex);\n    ++\tup_read(\u0026kernfs_rwsem);\n    + out_bad_unlocked:\n    + \treturn 0;\n    + }\n    +@@ fs/kernfs/dir.c: struct kernfs_node *kernfs_find_and_get_node_by_id(struct kernfs_root *root,\n    + \t}\n    + \n    + \t/*\n    +-\t * ACTIVATED is protected with kernfs_mutex but it was clear when\n    ++\t * ACTIVATED is protected with kernfs_sem but it was clear when\n    + \t * @kn was added to idr and we just wanna see it set.  No need to\n    +-\t * grab kernfs_mutex.\n    ++\t * grab kernfs_sem.\n    + \t */\n    + \tif (unlikely(!(kn-\u003eflags \u0026 KERNFS_ACTIVATED) ||\n    + \t\t     !atomic_inc_not_zero(\u0026kn-\u003ecount)))\n     @@ fs/kernfs/dir.c: int kernfs_add_one(struct kernfs_node *kn)\n   